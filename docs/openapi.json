{
  "openapi": "3.0.3",
  "info": {
    "title": "CRYPTO-TRACE INDIA API",
    "version": "1.0.0",
    "description": "Synthetic cybercrime investigation prototype. Enter POST /api/auth/demo first to receive an HttpOnly ct_session cookie. All data and reports are scoped to that anonymous workspace. No live blockchain feed, government integration, production investigator identity or automated external action."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "demoSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ct_session"
      }
    },
    "schemas": {
      "CreateCase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "complaintId": {
            "type": "string"
          },
          "fraudType": {
            "type": "string",
            "enum": [
              "Investment Scam",
              "Task Scam",
              "Phishing",
              "Sextortion",
              "Ransomware",
              "Darknet",
              "Financial Fraud",
              "Other"
            ]
          },
          "victimLoss": {
            "type": "number",
            "minimum": 0.01
          },
          "currency": {
            "type": "string",
            "enum": [
              "INR"
            ]
          },
          "reportedWallet": {
            "type": "string"
          },
          "chain": {
            "type": "string",
            "enum": [
              "Ethereum",
              "Polygon",
              "BNB Chain",
              "Bitcoin",
              "TRON"
            ]
          },
          "transactionHash": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "fraudType",
          "victimLoss",
          "reportedWallet",
          "chain"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  },

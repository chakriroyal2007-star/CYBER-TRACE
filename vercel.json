{
  "env": {
    "ALLOW_PRODUCTION_DEMO": "true",
    "DEMO_MODE": "true"
  },
  "functions": {
    "api/index.js": {
      "excludeFiles": "data/elliptic/elliptic_txs_features.csv"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

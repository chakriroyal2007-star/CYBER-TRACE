# Synthetic demonstration only. No external credentials are required.
# npm start does not read this file automatically. Use:
# node --env-file=.env server/index.mjs
NODE_ENV=production
HOST=0.0.0.0
PORT=8000

# SQLite database, PDF report blobs, sessions, cases, and audit history.
# Mount this directory to durable storage in a hosted deployment.
DB_PATH=./data/cryptotrace.sqlite
PYTHON_BIN=python3

# Same-origin hosting is the supported default. Leave blank unless a specific
# alternate frontend origin must be allowed, for example https://demo.example.org.
FRONTEND_ORIGIN=
SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=180
MAX_DEMO_SESSIONS=1000

# DATABASE_URL, JWT_SECRET, BLOCKCHAIN_API_KEY, AI_API_KEY, and NEO4J_* are not
# consumed by this build. Supplying them does not enable integrations.

# npm start does not read this file automatically; use node --env-file=.env server/index.mjs
NODE_ENV=production
HOST=127.0.0.1
PORT=8000
# Keep database AND evidence on durable private storage.
DB_PATH=./data/cryptotrace.sqlite
EVIDENCE_DIR=./data/evidence
FRONTEND_ORIGIN=
SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=180
# Explicit legacy demonstration only; real complaint operation keeps this false.
DEMO_MODE=false
# Optional public blockchain / external language-model integrations.
# Classroom presentation and saved ML models work offline.
OPENROUTER_API_KEY=
ETHEREUM_RPC_URL=
OFFICER_EMAIL_DOMAINS=cbi.gov.in,gov.in,nic.in
